# Copy this file to .env and fill in your values

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: paste a Slack/Discord "Incoming Webhook" URL to auto-notify
# on every campaign generation. Leave blank to skip automation trigger.
WEBHOOK_URL=

# Where Chroma stores brand memory (created automatically)
CHROMA_PATH=./chroma_store

# Where generated PDFs and logs are written
OUTPUT_DIR=./outputs
